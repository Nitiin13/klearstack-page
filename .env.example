# KlearStack Next.js Environment Variables (DO NOT COMMIT SECRETS TO GIT)

# 1. HubSpot Private App Access Token (CRM Contacts API)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 2. Google Sheets Apps Script Web App Endpoint URL (doPost)
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/AKfycbx.../exec

# 3. Resend Email API Key
RESEND_API_KEY=re_123456789_xxxxxxxx

# 4. Email Recipient for Notification Alerts
NOTIFY_TO_EMAIL=demo@example.com

# 5. Cal.com Booking Link (Public URL for client embed)
CALCOM_LINK=https://cal.com/demo/
NEXT_PUBLIC_CALCOM_LINK=https://cal.com/demo/example